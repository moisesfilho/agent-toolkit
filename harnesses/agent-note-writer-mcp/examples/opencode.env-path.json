{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "note_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "coder": {
      "permissions": [
        {
          "action": "note_coder_append",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "note_coder": {
        "type": "local",
        "codemode": false,
        "command": [
          "sh",
          "-c",
          "exec \"$NODE_BIN\" \"$AGENT_TOOLKIT_DIR/harnesses/agent-note-writer-mcp/index.mjs\" --role coder"
        ],
        "environment": {
          "AGENT_TOOLKIT_DIR": "/path/to/agent-toolkit",
          "NODE_BIN": "/path/to/node"
        }
      }
    }
  }
}
